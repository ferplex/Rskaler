{
  "name": "rskaler",
  "version": "1.0.0",
  "description": "Escalador 4K para wallpapers - Procesa imágenes de Stable Diffusion usando solo tu CPU",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.ferplex.rskaler",
    "productName": "Rskaler",
    "win": {
      "target": "portable",
      "icon": "abeja-256.png"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "abeja-256.png"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}